{
  "name": "cine-local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api": "node scripts/api-server.mjs",
    "serve": "vite build && node scripts/api-server.mjs",
    "artwork": "node scripts/fetch-artwork.mjs",
    "doctor": "node scripts/doctor.mjs",
    "import": "node scripts/import-catalog.mjs",
    "lint": "oxlint",
    "scan": "node scripts/scan-media.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify-features.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/test-e2e-isolated.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
